# Copy to .env.local for local development, and add the same keys in Vercel → Project → Settings → Environment Variables.

# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.abhivorn.com

# EmailJS — contact form delivery
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_CONTACT_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Analytics (all optional — each one turns on only when its key is set)
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=
# Google Ads conversion tag already used on the site
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-18110944464
# Microsoft Clarity project ID (heatmaps + session recordings)
NEXT_PUBLIC_CLARITY_ID=
